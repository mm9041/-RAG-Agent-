# ===== 环境变量 =====
# 内含 DASHSCOPE / LANGSMITH / TAVILY / MINERU / SERPAPI 等多组真实 API Key
.env
.env.*
!.env.example

# ===== 本地签名密钥 =====
# 用户端会话 cookie 的 HMAC 密钥，泄漏即可伪造任意演示身份
.session_secret

# ===== 前端 =====
web/node_modules/
# 构建产物：start.ps1 会在缺失时自动构建
web/dist/

# ===== 向量库 =====
# 可由 data/ 目录重建，且含大量二进制文件，不入库
chroma_db/

# ===== 对话记忆（LangGraph checkpointer）=====
checkpoints.sqlite*

# ===== 日志 =====
logs/

# ===== 旧版去重清单（已被 chroma_db/kb_meta.json 取代）=====

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ===== IDE =====
.idea/
.vscode/

# ===== 虚拟环境 =====
.venv/
venv/
env/

feedback.sqlite*
kb_versions/

# 知识库发布的运行时状态：由 utils/knowledge_admin 写入，
# 每台机器上的 model/scope/version 可能不同，且含文件锁
data/.catalog.json
data/.edit.lock

admin_sessions.sqlite*

.config_guard.sqlite*
/优化建议-2026-09-30.md

# ===== 本地工作记忆（WorkBuddy）=====
# 项目内的会话记录与记忆文件，属于本地工作数据
.workbuddy/
