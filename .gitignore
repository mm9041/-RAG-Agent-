# ===== 环境变量 =====
# 内含 DASHSCOPE / LANGSMITH / TAVILY / MINERU / SERPAPI 等多组真实 API Key
.env
.env.*
!.env.example

# ===== 本地签名密钥 =====
# 用户端会话 cookie 的 HMAC 密钥，泄漏即可伪造任意演示身份
.session_secret

# ===== 前端 =====
web/node_modules/
# 构建产物：start.ps1 会在缺失时自动构建
web/dist/

# ===== 向量库 =====
# 可由 data/ 目录重建，且含大量二进制文件，不入库
chroma_db/

# ===== 运行时数据库 =====
# 对话记忆（LangGraph checkpointer）：含完整消息，且带 -wal/-shm/-bak 兄弟文件
checkpoints.sqlite*
# 点赞反馈
feedback.sqlite*
# 管理员令牌（服务端只存摘要，仍属运行时状态）
admin_sessions.sqlite*
# 模型配置热更新的跨进程锁
.config_guard.sqlite*

# 知识库发布的运行时状态：由 utils/knowledge_admin 写入，
# 每台机器上的 model/scope/version 可能不同，且含文件锁
data/.catalog.json
data/.edit.lock
# 发布时保留的历史版本，可由 data/ 重建
kb_versions/

# ===== 日志 =====
logs/

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ===== 虚拟环境 =====
.venv/
venv/
env/

# ===== IDE =====
.idea/
.vscode/
# Qoder 的画布与报告缓存，与项目无关
.qoder-credits/

# ===== 工具产物 =====
# tools/side-confirm-check.mjs 等脚本跑出来的截图
tools/*.png

# ===== 系统文件 =====
Thumbs.db
Desktop.ini
.DS_Store

# ===== 本地备忘 =====
# 个人笔记，只留本地，不进仓库
/优化建议-2026-09-30.md
/优化记录-2026-10-30.md
/功能与测试说明.md
/优化记录-2026-10-30.md
/功能与测试说明.md

# ===== 本地工作记忆（WorkBuddy）=====
# 项目内的会话记录与记忆文件，属于本地工作数据
.workbuddy/
