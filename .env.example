# ===== 必填：对话模型 与 Embedding =====
# 本项目通过 OpenAI 兼容接口调用 DashScope（通义千问）
# 申请地址：https://bailian.console.aliyun.com/  → API-KEY 管理
DASHSCOPE_API_KEY=sk-在此填入你的Key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 访问控制 =====
# 设置后页面会要求输入密码才能使用；不设置则进入「本地演示模式」并在页面顶部告警。
# 这是演示级门禁（单一共享密码），真实系统请换成正式鉴权。
# APP_PASSWORD=change-me

# ===== 可选：LangSmith 链路追踪 =====
# 打开后每次问答的完整调用链会上传到 LangSmith，便于排查"模型为什么这么答"。
# 注意：会上传用户提问与工具返回内容，对外交付前建议关闭。
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=lsv2_在此填入你的Key
# LANGSMITH_PROJECT=agent-demo

# 说明：模型名与向量库参数不在 .env 里，而在 config/*.yml 中。
#   config/model.yml  -> chat_model_name / embedding_model_name
#   config/chroma.yml -> 向量库路径、切分参数、检索条数、重排与超时
#   config/agent.yml  -> 外部数据路径、演示用参考月份

# 管理知识文件和查看反馈的独立密码（不设置则禁用管理功能）
ADMIN_PASSWORD=
